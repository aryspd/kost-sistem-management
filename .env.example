# ===== Database (SQLite lokal, tanpa perlu install apa-apa) =====
DATABASE_URL="file:./dev.db"

# ===== Login Admin =====
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
# String acak panjang untuk menandatangani sesi login
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang"

# ===== Identitas Kost (tampil di kwitansi & pesan WA) =====
KOST_NAME="Kost Harmoni"
KOST_ADDRESS="Jl. Melati No. 12, Yogyakarta"
KOST_PHONE="081234567890"
KOST_BANK="BCA 1234567890 a.n. Pemilik Kost"

# URL publik aplikasi (dipakai untuk link kwitansi di WhatsApp)
BASE_URL="http://localhost:3000"

# ===== WhatsApp Gateway (opsional) =====
# Kosongkan -> sistem memakai link wa.me (buka WhatsApp & kirim manual, gratis)
# Isi token Fonnte (https://fonnte.com) -> pesan + PDF kwitansi terkirim otomatis
FONNTE_TOKEN=""

# Kunci rahasia untuk endpoint cron pengingat otomatis (/api/cron/reminder?key=...)
CRON_SECRET="rahasia-cron"
